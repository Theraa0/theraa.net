---
import '../styles/global.css'
const { title } = Astro.props;
---
<script>
const title = document.getElementById("pageTitle").innerHTML;
if (document.getElementById(title)) {
	document.getElementById(title).classList.add("active");
}
const pathname = document.getElementById("subtitle").innerHTML;
document.getElementById("subtitle").innerHTML = "";
const path = pathname.split("/");
for ( var i = 0; i < (path.length - 1); i++ ) {
	const a = document.createElement("a");
	for ( var ii = 0; ii < i + 2; ii++ ) {
		a.href = a.href + path[ii] + "/";
	}
	a.innerText = "/" + path[i+1];
	a.class = "pathLink";
	document.getElementById("subtitle").appendChild(a);
}
</script>
<table class="header">
	<tr>
		<td class="main">
			<h1>
				<span>theraa.net:</span>
				<span id="pageTitle">{title}</span>
			</h1>
		</td>
	</tr>
	<tr>
		<td class="sub">
			<span id="subtitle">{Astro.url.pathname}</span>
		</td>
	</tr>
</table>
<table class="tabs">
	<tr>
		<td>
			<a id="home" href="/home">home</a>
		</td>
		<td>
			<a id="blog" href="/blog">blog</a>
		</td>
		<td>
			<a id="about" href="/about">about</a>
		</td>
	</tr>
</table>
