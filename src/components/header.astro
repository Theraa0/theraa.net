---
import '../styles/global.css'
const { title } = Astro.props;
---
<script>
const pathname = document.getElementById("header-sub").innerHTML;
document.getElementById("header-sub").innerHTML = "";
const path = pathname.split("/");
for ( var i = 0; i < (path.length - 1); i++ ) {
	const a = document.createElement("a");
	for ( var ii = 0; ii < i + 2; ii++ ) {
		a.href = a.href + path[ii] + "/";
	}
	a.innerText = "/" + path[i+1];
	document.getElementById("header-sub").appendChild(a);
}
</script>
<a href="#main" class="skipToMain isSectionLink">Skip to main</a>
<h1 id="header-main"><span>theraa.net:</span><span>{title}</span></h1>
<p id="header-sub">{Astro.url.pathname}</p>
<div id="header-tabs">
	<a id="home" href="/home">home</a>
	<a id="about" href="/about">about</a>
	<a href="/home#sitemap">sitemap</a>
	<a id="reading" href="/books">reading</a>
</div>
