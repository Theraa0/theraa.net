---
import '../styles/global.css'
const { title } = Astro.props;
---
<script>
document.getElementById("header-sub").innerHTML = "";
const path = window.location.pathname.replace(/\/$/g, "").split("/");
for (var i=1; i < path.length; i++) {
	const a = document.createElement("a");
	for (var j=1; j <= i; j++) {
		a.href= a.href + "/" + path[j];
	}
	a.innerText = "/" + path[i];
	document.getElementById("header-sub").appendChild(a);
}
</script>
<h1 id="header-main"><span>theraa.net: </span><span id="header-title">{title}</span></h1>
<p id="header-sub">&#8203;</p>
<div id="header-tabs">
	<a id="home" href="/home">home</a>
	<a id="about" href="/about">about</a>
	<a href="/home#sitemap">sitemap</a>
	<a id="reading" href="/books">reading</a>
</div>
