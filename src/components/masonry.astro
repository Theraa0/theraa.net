---
import '../styles/masonry.css'
const { minWidth }: Props = Astro.props;
---
<script is:inline>
(function(window, document, undefined) {
	window.onload = init;
	function init(){
		const body_width = document.getElementById("initialElements").offsetWidth;
		const min_width = document.getElementById("minWidth").innerHTML;
		const columns = Math.floor(body_width / min_width);
		const column_width = body_width/columns-(((columns-1)*8)/columns);
		const elements = document.getElementById("initialElements").children;
		for (var i = 0; i < elements.length; i++) {
			elements[i].style.width = column_width + "px";
		}
		for (var i = 0; i < columns; i++) {
			let div = document.createElement("div");
			div.id = "div-" + i;
			div.classList.add("masonry-col");
			document.getElementById("masonry").appendChild(div);
		}
		const elegarrlen = elements.length;
		for (var j = 0; j < elegarrlen; j++) {
			columnLength = new Array();
			for (var i = 0; i < columns; i++) {
				columnLength.push(document.getElementById("div-"+i).offsetHeight);
			}
			const shortestColumn = columnLength.indexOf(Math.min.apply(null, columnLength));
			let movingElement = document.getElementById("initialElements").lastElementChild;
			document.getElementById("div-" + shortestColumn).appendChild(movingElement);
			movingElement.style.display = "initial";
		}
	}
})(window, document, undefined);
</script>
<p id="minWidth" style="display: none">{minWidth}</p>
<div id="initialElements">
<slot />
</div>
<div id="masonry">
</div>
