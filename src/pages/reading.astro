---
import Layout from '../layouts/layout.astro'
---
<style>
ul {
	list-style: none;
	padding: 0;
	margin: 0 0 0 2ch;
}
</style>
<Layout title="reading">
	<p>This page is intended as a place for me to recommend some books, because being recommended a book in person often ends up not being the ideal place for various reasons.</p>
	<p>It'll also be an exercise for me to actually think about the stuff I've read as I feel like I havent been doing that enough</p>
	<p><i>*this will hopefully be replaced with api calls soon*</i></p>
	<p id="test"></p>
</Layout>

<script>
async function getBooks() {
	const url = "https://openlibrary.org/people/theraa/books/already-read.json";
	try {
		const response = await fetch(url);
		if (!response.ok) {
			throw new Error(`Response status: ${response.status}`);
		}
		const json = await response.json();
		console.log(json);
		document.getElementById("test").innerHTML = json;
	} catch (error) {
		console.error(error.message);
	}
}
</script>
