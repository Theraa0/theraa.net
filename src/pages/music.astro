---
import Layout from '../layouts/layout.astro'
import '../styles/music.css'
---
<script>
const apiUrl = 'https://ws.audioscrobbler.com/2.0/?method=user.gettopalbums&user=theracraft&api_key=b7d11a24486dd9d1e6d0076602abf245&format=json&period=12month&limit=36'

fetch(apiUrl)
	.then(response => {
		if (!response.ok) {
			throw new Error('Network response was not ok');
		}
		return response.json();
	})
	.then(data => {
		for (let i = 0; i < Object.keys( data.topalbums.album ).length; i++) {
			let cover = document.createElement("img");
			cover.src = data.topalbums.album[i].image[2]['#text'];
			cover.alt = data.topalbums.album[i].name;
			cover.classList.add("cover");
			let link = document.createElement("a");
			link.href = data.topalbums.album[i].url;
			link.target = "_blank";
			link.appendChild(cover);
			document.getElementById("covers").appendChild(link);
		}
	})
	.catch(error => {
		console.error('Error:', error);
	});
</script>
<Layout title="music" description="this is apparently the music i listen to the most">
<p>Here u can find a bunch of my supposed "Top Albums" on <a href="https://www.last.fm">last.fm</a>, tho these aren't actually fully representative cuz of various reasons</p>
<div id="covers" class="center"></div>
</Layout>
