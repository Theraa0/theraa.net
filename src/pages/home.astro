---
import Layout from '../layouts/layout.astro'
import '../styles/home.css'
const allPages = await Astro.glob(['./*.astro', './cool/*.astro']);
---
<script is:inline>
(function(window, document, undefined) {
	window.onload = init;
	function init(){
		const body_width = document.getElementById("sitemap").offsetWidth;
		const min_width = 90;
		const columns = Math.floor(body_width / min_width);
		const column_width = body_width/columns;
		const children = document.getElementById("sitemap").children;
		for (var i = 0; i < children.length; i++) {
			if(children[i].offsetWidth > column_width) {
				children[i].style.width = column_width * 2 + "px";
			} else {
				children[i].style.width = column_width + "px";
			}
		}
	}
})(window, document, undefined);
function addMyButton() {
	//const addMyButton = '<a href="https://theraa.net/"><img src="/https://theraa.net/myButtons/theraa-button-31.gif" width="88" height="31" alt="theraa.net"></a>';
	const addMyButton = document.getElementById("test").innerHTML.replaceAll("&lt;", "<").replaceAll("&gt;", ">");
	navigator.clipboard.writeText(addMyButton);
}
</script>
