---
import Layout from '../layouts/layout.astro'
import '../styles/buttons.css'
const allPages = await Astro.glob('./*.astro');
---
<style>
#sitemap {
	display: flex;
	flex-flow: row wrap;
}
/* divide 100% by ?ch then round down and divide 100% by result */
#sitemap a {
	min-width: calc(100% / 3);
	height: 1.3em;
}
</style>
<Layout title="home">
		<p>hi, welcome to my site. everything is still work in progress so please excuse any possible crazyness. if you have any suggestions please mail me at <a href="mailto:theraa@duck.com">theraa@duck.com</a> or through any of <a href="contact.html">my socials</a>.</p>
		<h1>sitemap</h1>
		<div id=sitemap>
			{allPages.map((page) => <a href={page.url}>{page.url}</li>)}
		</div>
		<h1>cool buttons</h1>
		<div class="buttons center">
			<a href="https://theanarchistlibrary.org/">
				<img class="button" src="buttons/crushit.gif" width="88" height="31" alt="lets crush capitalism">
			</a>
			<a href="https://www.mozilla.org/en-US/firefox/download/thanks/">
				<img class="button" src="buttons/fftake.gif" width="88" height="31" alt="take back the web">
			</a>
			<a href="https://www.kernel.org/linux.html">
				<img class="button" src="buttons/penguins.gif" width="88" height="31" alt="powered by: penguins">
			</a>
			<a href="https://www.youtube.com/watch?v=NY__VTIUsiU">
				<img class="button" src="buttons/miku.gif" width="88" height="31" alt="this site is miku approved">
			</a>
			<a href="">
				<img class="button" src="buttons/nocookie.gif" width="88" height="31" alt="This site is certified 100% cookie free!">
			</a>
			<a href="https://www.vim.org/">
				<img class="button" src="buttons/vim.vialle.love.anim.gif" width="88" height="31" alt="Edited with Vim">
			</a>
			<a href="https://home.cern/science/computing/birth-web/short-history-web">
				<img class="button" src="buttons/wwwbutton.gif" width="88" height="31" alt="WORLD WIDE WEB Connecting people Since 1991">
			</a>
			<a href="https://youtu.be/YQ_xWvX1n9g?si=srejvqNa1KdQ_oNb">
				<img class="button" src="buttons/nfthanks.gif" width="88" height="31" alt="nft? no fucking thanks">
			</a>
			<a href="https://youtu.be/dQw4w9WgXcQ?si=gd8pSYzuBsMjwuGO">
				<img class="button" src="buttons/jollodotorg-defcon1.gif" width="88" height="31" alt="not secure">
			</a>
			<a href="">
				<img class="button" src="buttons/monster-button.gif" width="88" height="31" alt="powered by monster energy">
			</a>
			<a href="https://en.wikipedia.org/wiki/Eat_the_rich#Origin">
				<img class="button" src="buttons/eattherich.gif" width="88" height="31" alt="eat the rich">
			</a>
			<a href="https://www.w3schools.com/html">
				<img class="button" src="buttons/learn-html.gif" width="88" height="31" alt="HTML, learn it today">
			</a>
			<a href="">
				<img class="button" src="buttons/toostupid.gif" width="88" height="31" alt="too stupid to slep">
			</a>
			<a href="https://archlinux.org/">
				<img class="button" src="buttons/archbtw.gif" width="88" height="31" alt="i use arch btw">
			</a>
			<a href="https://myanimelist.net/anime/39792/Eizouken_ni_wa_Te_wo_Dasu_na">
				<img class="button" src="buttons/eizouken.gif" width="88" height="31" alt="keep your hands off eizouken">
			</a>
		</div>
</Layout>
