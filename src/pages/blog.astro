---
import Layout from '../layouts/layout.astro'
import Listing from '../components/mdPostListing.astro'
const allPosts = await Astro.glob('./blog/*.md');
---
<style>
ul {
}
</style>
<Layout title="blog" description="i attempt to write a blog without having anything to talk about">
	<h1>Notes</h1>
	<p>I'm not even that interested in writing a blog, but having this won't hurt ig.</p>
	<h1>Posts</h1>
	<ul>
	{allPosts.map((post) => <Listing post={post} />)}
	</ul>
</Layout>
