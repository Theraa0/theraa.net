---
import Layout from '../layouts/layout.astro'
import Masonry from '../components/masonry.astro'
import { Image } from 'astro:assets'

const images = await Astro.glob('../assets/*');
---
<Layout title="pics test" description="temp; pls ignore">
<p>I made this page to develop my new masonry image component, but I dont actually have any relevant images to display yet. This site will stay up for a while so I don't forget how it works.</p>
<p>At the time these were the first few images in my memes folder so do whatever you want with that information</p>
<Masonry minWidth="120">
	{
		images.map((img) => (
		<div class="masonry-element"><a href={img.default.src}>
			<Image
      		src={img.default}
      		alt="a meme"
      	/>
			<span></span>
			</a></div>
   	))
	}
</Masonry>
</Layout>
