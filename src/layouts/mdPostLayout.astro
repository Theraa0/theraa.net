---
import '../styles/global.css'
import Layout from '../layouts/layout.astro'
const { frontmatter } = Astro.props;
---
<Layout title={frontmatter.title}>
	<p>{new Date(frontmatter.pubDate).toLocaleDateString('en-us', {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		})}</p>
	<slot />
</Layout>

